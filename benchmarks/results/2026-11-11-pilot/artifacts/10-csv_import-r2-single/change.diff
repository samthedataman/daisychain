+def _validate_quoting(text):
+    """Reject quotes outside quoted fields, including trailing field text."""
+    state = "start"
+    for char in text:
+        if state == "quoted":
+            if char == '"':
+                state = "closed"
+        elif state == "closed":
+            if char == '"':
+                state = "quoted"
+            elif char == ',':
+                state = "start"
+            elif char in '\r\n':
+                state = "start"
+            else:
+                raise ValueError("Unexpected text after a quoted field")
+        elif char == '"':
+            if state != "start":
+                raise ValueError("Quote inside an unquoted field")
+            state = "quoted"
+        elif char == ',' or char in '\r\n':
+            state = "start"
+        else:
+            state = "unquoted"
+    if state == "quoted":
+        raise ValueError("Unterminated quoted field")
+
